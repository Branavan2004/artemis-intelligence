# ============================================================
# Artemis Intelligence — Server Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/artemis_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# AI APIs
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_KEY
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY

# NASA API (https://api.nasa.gov)
NASA_API_KEY=REPLACE_WITH_YOUR_NASA_KEY

# CORS — frontend URL
CLIENT_URL=http://localhost:5173
